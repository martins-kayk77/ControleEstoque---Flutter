rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDocument() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function validUserProfileData() {
      return request.resource.data.keys().hasAll([
          'email',
          'displayName',
          'cpf',
          'birthDate',
          'companyIds',
          'activeCompanyId',
          'createdAt',
          'updatedAt',
        ])
        && request.resource.data.keys().hasOnly([
          'email',
          'displayName',
          'cpf',
          'birthDate',
          'companyIds',
          'activeCompanyId',
          'createdAt',
          'updatedAt',
        ])
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.cpf is string
        && request.resource.data.cpf.matches('^[0-9]{11}$')
        && request.resource.data.birthDate is timestamp
        && request.resource.data.companyIds is list
        && (
          request.resource.data.activeCompanyId == null ||
          request.resource.data.activeCompanyId is string
        );
    }

    function userIdentityWasNotChanged() {
      return request.resource.data.email == resource.data.email
        && request.resource.data.cpf == resource.data.cpf
        && request.resource.data.birthDate == resource.data.birthDate
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function isCompanyMember(companyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && companyId in userDocument().data.companyIds;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && validUserProfileData();
      allow update: if signedIn()
        && request.auth.uid == userId
        && validUserProfileData()
        && userIdentityWasNotChanged();
      allow delete: if false;
    }

    match /companies/{companyId} {
      function validStockCountNumberUpdate() {
        let previous = resource.data.get('lastStockCountNumber', 0);
        let next = request.resource.data.get('lastStockCountNumber', 0);
        let countId = request.resource.data.get('activeStockCountId', null);
        return next == previous || (
          next is int && next == previous + 1
          && countId is string
          && getAfter(/databases/$(database)/documents/companies/$(companyId)/stockCounts/$(countId)).data.number == next
          && getAfter(/databases/$(database)/documents/companies/$(companyId)/stockCounts/$(countId)).data.startedAt == request.time
        );
      }

      allow read, delete: if isCompanyMember(companyId);
      allow update: if isCompanyMember(companyId) && validStockCountNumberUpdate();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;

      match /members/{memberId} {
        allow read, write: if isCompanyMember(companyId);
      }

      match /products/{productId} {
        allow read, write: if isCompanyMember(companyId);
      }

      match /categories/{categoryId} {
        allow read, write: if isCompanyMember(companyId);
      }

      match /movements/{movementId} {
        allow read, write: if isCompanyMember(companyId);
      }

      match /stockCounts/{stockCountId} {
        allow read: if isCompanyMember(companyId);
        allow create: if isCompanyMember(companyId)
          && request.resource.data.companyId == companyId
          && request.resource.data.status == 'inProgress'
          && request.resource.data.responsibleUserId == request.auth.uid
          && request.resource.data.startedAt == request.time
          && request.resource.data.number is int
          && request.resource.data.number > 0
          && request.resource.data.number == getAfter(/databases/$(database)/documents/companies/$(companyId)).data.lastStockCountNumber
          && request.resource.data.number == get(/databases/$(database)/documents/companies/$(companyId)).data.get('lastStockCountNumber', 0) + 1
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0
          && request.resource.data.items.size() <= 200;
        allow update: if isCompanyMember(companyId)
          && resource.data.status == 'inProgress'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'items', 'status', 'updatedAt', 'completedAt', 'completedByUserId', 'revision'
          ])
          && request.resource.data.status in ['inProgress', 'completed', 'canceled']
          && request.resource.data.items is list
          && request.resource.data.items.size() == resource.data.items.size()
          && (request.resource.data.status != 'completed'
            || (request.resource.data.completedAt == request.time
              && request.resource.data.completedByUserId == request.auth.uid));
        allow update: if isCompanyMember(companyId)
          && resource.data.status == 'completed'
          && resource.data.get('adjustedAt', null) == null
          && (resource.data.get('operationId', null) == null
            || resource.data.get('operationId', null) == '')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'operationId', 'adjustedAt', 'adjustedByUserId', 'adjustedByName', 'updatedAt'
          ])
          && request.resource.data.operationId is string
          && request.resource.data.operationId.size() > 0
          && request.resource.data.adjustedAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.adjustedByUserId == request.auth.uid
          && request.resource.data.adjustedByName is string;
        allow delete: if false;
      }

      match /sales/{saleId} {
        allow read, write: if isCompanyMember(companyId);
      }

      match /salesChannels/{channelId} {
        allow read, write: if isCompanyMember(companyId);
      }

      match /pricingPlatforms/{platformId} {
        allow read, write: if isCompanyMember(companyId);
      }
    }
  }
}
