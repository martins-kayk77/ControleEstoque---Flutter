rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDocument() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isCompanyMember(companyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && companyId in userDocument().data.companyIds;
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /companies/{companyId} {
      allow read, update, delete: if isCompanyMember(companyId);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;

      match /members/{memberId} {
        allow read, write: if isCompanyMember(companyId);
      }

      match /products/{productId} {
        allow read, write: if isCompanyMember(companyId);
      }

      match /categories/{categoryId} {
        allow read, write: if isCompanyMember(companyId);
      }

      match /movements/{movementId} {
        allow read, write: if isCompanyMember(companyId);
      }

      match /stockCounts/{stockCountId} {
        allow read, write: if isCompanyMember(companyId);
      }

      match /sales/{saleId} {
        allow read, write: if isCompanyMember(companyId);
      }

      match /salesChannels/{channelId} {
        allow read, write: if isCompanyMember(companyId);
      }

      match /pricingPlatforms/{platformId} {
        allow read, write: if isCompanyMember(companyId);
      }
    }
  }
}
